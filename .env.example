# This file documents every env var used across the monorepo for reference.
# It is NOT loaded directly by either app — each app reads its own local env
# file (never committed):
#   apps/api/.env         <- see apps/api/.env.example
#   apps/web/.env.local    <- see apps/web/.env.local.example
#
# infra/docker-compose.yml reads POSTGRES_PASSWORD from your shell environment
# or a .env file placed next to it (docker compose's own convention, separate
# from the app .env files above).

# --- apps/api/.env ---
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://tradingos_app:CHANGE_ME@localhost:5432/tradingos
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ANTHROPIC_API_KEY=

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- infra/docker-compose.yml (optional, only if you use Docker instead of
# the native Postgres install described in README.md) ---
POSTGRES_PASSWORD=CHANGE_ME
