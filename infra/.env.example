# Copy to infra/.env and fill in real values, or export these in your
# shell before running `docker compose -f infra/docker-compose.yml up`.
# Never commit the filled-in version (infra/.env is gitignored via the
# root .gitignore's `.env*` pattern).

POSTGRES_PASSWORD=CHANGE_ME

# Optional — the app degrades gracefully without these (synthetic
# providers, or a clear 503 for the NL-query feature), same as local dev.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ANTHROPIC_API_KEY=

# Must be an origin your actual browser can reach — not the internal
# Docker service hostname (`http://api:8000`) — since NEXT_PUBLIC_API_URL
# is baked into the web image's client JS bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

ENVIRONMENT=production
