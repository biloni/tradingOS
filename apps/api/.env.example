ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: NL query / draft_document features no-op gracefully when absent
ANTHROPIC_API_KEY=
