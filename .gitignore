# Env files (never commit real secrets). `.env*` catches every variant,
# including ones no one anticipated by name yet (.env.production,
# .env.staging, ...) — the old .env/.env.local/.env.*.local trio left
# exactly that gap: a real deployment env file that isn't a `.local`
# suffix would not have matched any of the three (Revision Prompt 16
# secret-scanning review, ADR-070). The two `!` lines re-allow the
# committed placeholder files.
.env*
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
dist/
coverage/
.turbo/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# uv
uv.lock.tmp

# Database backups (Revision Prompt 16, task: backup/restore tooling) —
# local operational data, may contain real seeded/paper-trading data,
# never committed.
apps/api/backups/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
